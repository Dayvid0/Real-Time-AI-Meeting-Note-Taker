DEEPGRAM_KEY=
APP_ENV=development
# Free summary setup: create a Gemini key at https://aistudio.google.com/apikey.
# Use a Free-tier project; do not enable billing. Quotas apply.
# Google may use free-tier content to improve products. Deepgram is separate.
LLM_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
# Optional conservative per-meeting notes budget; not a billing meter.
LLM_TOKEN_BUDGET=120000
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
TOKEN_SECRET=
TOKEN_TTL=60
TOKEN_RATE_LIMIT=10
# Optional for local development. Set to your exact chrome-extension://<id> origin when shared.
# Required in production and must contain exactly one extension origin.
ALLOWED_ORIGINS=
