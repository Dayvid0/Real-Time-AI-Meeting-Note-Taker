# Meeting Notes AI backend environment.
# Copy to backend/.env for local development. Never commit real secrets.

# --- Required in production ---
# Secret used to sign/verify short-lived WebSocket tokens. Use a long random
# value (32+ bytes), e.g. `openssl rand -hex 32`.
JWT_SECRET=dev-secret-please-change-me-32bytes

# Deepgram API key for real-time ASR. If unset, the server runs in
# control-only mode (no transcription).
DEEPGRAM_API_KEY=

# OpenAI API key for summaries and final notes. If unset, summarization is
# disabled and the server returns "LLM not configured".
OPENAI_API_KEY=

# --- Optional tuning ---
OPENAI_MODEL=gpt-4o-mini
JWT_TTL_SECONDS=300
SUMMARY_TOKEN_BUDGET=100000
MAX_FRAME_BYTES=65536
MAX_MESSAGES_PER_MIN=100
IDLE_TIMEOUT_SECONDS=600
ROLLING_SUMMARY_INTERVAL=60
